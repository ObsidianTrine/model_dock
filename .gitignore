node_modules/
dist/
*.log
.DS_Store

# 构建产物/发布包不进仓库（放 release/ 目录或挂到 GitHub Releases）
*.tgz
release/
.cache/

# 本机 ZCode 会话状态（config.json 例外：workspace hook 注册随仓库共享）
.zcode/*
!.zcode/config.json

.agents/worktrees/
NOTES.md
.claude/settings.local.json

/page*
.playwright-mcp/
.workbuddy/
.tz_backup/
.mcp.json
# orchestrator 运行态不入库（任务队列与事件日志）
.agents/orchestrator/queue/
.agents/orchestrator/logs/
# digest 冲刷运行态（flush-inflight / last.txt）；.agents/ 嵌套是 audit cwd 锚定 bug 的错位残留（真账本在 .agents/policy/audit.jsonl）
.agents/orchestrator/notify-digest/
.agents/orchestrator/.agents/

# 调度器/任务互斥锁（运行态；陈锁自动接管，不人工清理）
.agents/orchestrator/.scheduler-lock.json
.agents/orchestrator/.run-*.lock

# 策略拦截审计（运行态）
.agents/policy/audit.jsonl

# planner 草稿（确认路径产物，不进队列不入库）
.agents/orchestrator/drafts/

# 发版提案与 nightly 调度 wrapper（运行态产物，不入库）
.agents/orchestrator/release-proposals/
.agents/orchestrator/nightly-runner.*

# sail 停止信号与 digest 通报队列（巡航运行态，不入库）
.agents/orchestrator/.sail-stop
.agents/orchestrator/notify-digest/

# 规格三件套（spec 命令产物，人工审阅的工作区；拆出的任务卡进队列即完成使命）
.agents/orchestrator/specs/

# push 审查结论（push-review 命令运行态产物；hook 闸消费后按 24h/HEAD 失效）
.agents/orchestrator/push-review/

# vitest coverage 报告（test:coverage 产物，不入库）
coverage/
tmp/
# 调研 brief 与可信度产物（research 命令运行态产物，人工阅读的工作区；ledger/verdict/snapshot 均为对账材料）
.agents/orchestrator/research/
.agents/orchestrator/research-void/

# 通知摘要聚合器（notify-digest 运行态：pending.jsonl 队列 + flush-inflight marker + last.txt 详情档）
.agents/orchestrator/notify-digest/
*.output.txt

# 某些 Windows 工具在仓库根创建的注册表镜像空目录（审计 D-06，2026-11-26 已清理一次）
/HKCU/
