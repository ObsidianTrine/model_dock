{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // vitest.workflow.config.ts 等 import 带 .ts 后缀（noEmit 下安全启用）
    "allowImportingTsExtensions": true,
    // webui-dom.test 断言生成的内联页体，需要 DOM 类型
    "lib": ["ES2023", "DOM"],
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["test", "vitest.config.ts", "vitest.workflow.config.ts"],
  // exclude 当前为空：test/ 已全量纳入类型检查（test/orchestrator 经 agents-scripts.d.ts 的
  // any 边界收口）。要豁免一个文件必须同时改这里与 test/test-typecheck-gate.test.ts 的
  // REGISTERED_EXCLUDE 并写明理由——「新测试逃过类型检查」应当是显式决策，不是顺手加行。
  "exclude": []
}
