# EditorConfig 基线：https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 行尾双空格是合法换行语法，不裁剪
trim_trailing_whitespace = false

[*.{bat,cmd}]
# 批处理需要 CRLF（项目约定）
end_of_line = crlf

[*.sh]
# shell 脚本必须 LF，CRLF 会导致 Linux/macOS 无法执行
end_of_line = lf