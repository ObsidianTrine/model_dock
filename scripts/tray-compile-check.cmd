@echo off
rem Windows tray compile smoke gate: mirrors the csc invocation in scripts/build-sea.mjs
rem ensureWinTray (keep the flags in sync when either side changes). Used by
rem test/tray-compile.test.ts (win32-only) so a broken ModelDockTray.cs turns CI red
rem instead of only failing at release-build time.
rem Usage: tray-compile-check.cmd <repo-root>   (pure ASCII; Git Bash must invoke via cmd, not csc directly)
setlocal enabledelayedexpansion
set ROOT=%~1
if "%ROOT%"=="" exit /b 1
set SRC=%ROOT%\scripts\tray\ModelDockTray.cs
if not exist "%SRC%" exit /b 1

set CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe
if not exist "%CSC%" set CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe
if not exist "%CSC%" (
  echo [tray-compile-check] csc.exe not found - .NET Framework 4.x required
  exit /b 2
)

set OUTDIR=%TEMP%\mdk-tray-gate-%RANDOM%
mkdir "%OUTDIR%" >nul 2>nul

rem TrayMeta.Version is generated at release time (git tag); for the smoke gate a
rem constant stub is enough - only compilation is under test, not the version value.
>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo // generated by scripts/tray-compile-check.cmd (compile smoke only)
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo namespace ModelDockTray
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo {
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo     internal static class TrayMeta
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo     {
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo         internal const string Version = "0.0.0";
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo     }
>>"%OUTDIR%\ModelDockTray.Version.gen.cs" echo }

rem No /win32icon here (release-time ico generation is a build-sea concern); manifest kept:
rem it is part of the compile surface (PerMonitorV2 DPI declaration).
"%CSC%" /nologo /target:winexe /out:"%OUTDIR%\ModelDockTray.check.exe" /win32manifest:"%ROOT%\scripts\tray\ModelDockTray.manifest" /r:System.Windows.Forms.dll /r:System.Drawing.dll /r:System.Web.Extensions.dll "%SRC%" "%OUTDIR%\ModelDockTray.Version.gen.cs"
set RC=%ERRORLEVEL%
if exist "%OUTDIR%\ModelDockTray.check.exe" del "%OUTDIR%\ModelDockTray.check.exe" >nul 2>nul
del "%OUTDIR%\ModelDockTray.Version.gen.cs" >nul 2>nul
rmdir "%OUTDIR%" >nul 2>nul
exit /b %RC%
