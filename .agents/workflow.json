{
  "version": 1,
  "projectName": "ModelDock",
  "baseBranch": "develop",
  "testCmd": "npm test",
  "setupCmd": "npm ci --prefer-offline",
  "buildCmd": "npm run build",
  "packageManager": "npm",
  "listenCommandNames": [
    "modeldock",
    "gateway"
  ],
  "gatewayLogDir": "~/.modeldock/logs",
  "gatewayAdmin": true,
  "gatewayProvision": true,
  "scheduling": {
    "maxWorkers": 1
  },
  "protectedPorts": [
    "8687",
    "8890"
  ],
  "corePaths": [
    "src/cli.ts",
    "src/gateway/server.ts",
    "src/gateway/state.ts",
    "src/gateway/relay.ts",
    "src/config/store.ts",
    "src/config/secrets.ts",
    "src/util/paths.ts"
  ],
  "releasePaths": [
    ".github/workflows/",
    "scripts/build-sea.mjs",
    "scripts/build-all.mjs"
  ],
  "reviewNotes": "端口 8687/8890（8687=生产端口、8890=用户 dev 沙箱端口）、硬编码 ~/.modeldock 路径、绕过 atomicWrite() 直接写文件、使用 import.meta.url、新增 native addon、破坏 src/cli.ts 三路分发",
  "uiCheckCmd": "node scripts/ui-smoke.mjs",
  "worker": {
    "backend": "claude-headless",
    "model": "glm-5.3-flash"
  },
  "review": {
    "backend": "claude-headless",
    "model": "glm-5.3-flashx"
  },
  "scan": {
    "smartFilter": true,
    "smartModel": "glm-4.5-air"
  },
  "research": {
    "model": "glm-5.3-flash"
  },
  "propose": {
    "feedback": true,
    "model": "glm-5.3-flash"
  },
  "watchdog": {
    "mode": "actuate",
    "model": "glm-4.5-air"
  },
  "budgetProfiles": {
    "claude-headless": {
      "max_tokens": 20000000,
      "max_wall_minutes": 150
    },
    "zcode-headless": {
      "max_tokens": 20000000,
      "max_wall_minutes": 150
    }
  },
  "tiers": {
    "ahead-1": {
      "tokenEnv": "MDK_TIER_AHEAD1_TOKEN"
    },
    "ahead-2": {
      "tokenEnv": "MDK_TIER_AHEAD2_TOKEN"
    },
    "ahead-3": {
      "tokenEnv": "MDK_TIER_AHEAD3_TOKEN"
    },
    "ahead-4": {
      "tokenEnv": "MDK_TIER_AHEAD4_TOKEN",
      "workerModel": "glm-5.3"
    }
  },
  "autopilot": {
    "enabled": true,
    "autoSubmitTypes": [
      "docs",
      "bugfix",
      "refactor"
    ],
    "autoDrainPerCycle": 0,
    "maxProposalsPerCycle": 3
  },
  "upstream": {
    "specAutoBuild": {
      "enabled": true
    }
  },
  "autoResume": {
    "enabled": true
  },
  "configGuard": {
    "enabled": true
  },
  "draftsGc": {
    "autoSupersede": true,
    "archiveDays": 30
  },
  "scanAutoFix": {
    "enabled": true
  },
  "escalation": {
    "enabled": true,
    "fallbackBackend": "claude-headless"
  },
  "weatherHold": {
    "enabled": true,
    "threshold": 3,
    "windowMinutes": 60,
    "upstream": {
      "source": "metrics",
      "threshold": 5,
      "windowMinutes": 60
    }
  },
  "dynamicDispatch": {
    "enabled": true,
    "envelope": [
      "zcode-headless",
      "claude-headless"
    ]
  },
  "testCmdL0": "npx vitest run test/docs-lint.test.ts",
  "notify": {
    "keychainService": "modeldock-orch-feishu-webhook"
  }
}
