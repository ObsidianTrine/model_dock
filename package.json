{
  "name": "modeldock",
  "version": "1.0.0",
  "description": "ModelDock — 本地模型配置托管中心 + API 网关：一份配置管住所有 AI harness",
  "type": "module",
  "license": "MIT",
  "author": "ObsidianTrine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObsidianTrine/model_dock.git"
  },
  "homepage": "https://github.com/ObsidianTrine/model_dock#readme",
  "bugs": {
    "url": "https://github.com/ObsidianTrine/model_dock/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "gateway",
    "proxy",
    "claude-code",
    "codex",
    "api-gateway"
  ],
  "bin": {
    "modeldock": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:sea": "node scripts/build-sea.mjs",
    "dev": "tsx src/cli.ts",
    "dev:watch": "tsx watch src/cli.ts",
    "test": "tsc -p tsconfig.test.json --noEmit && vitest run",
    "test:workflow": "vitest run --reporter=dot -c vitest.workflow.config.ts",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "gen:ui-min": "node scripts/gen-ui-min.mjs",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.0.0",
    "qrcode-generator": "^2.0.4",
    "smol-toml": "^1.9.1",
    "undici": "^8.12.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "postject": "^1.0.0-alpha.6",
    "prettier": "^3.9.10",
    "resedit": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist"
  ]
}
