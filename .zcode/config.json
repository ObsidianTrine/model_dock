{
  "hooks": {
    "enabled": true,
    "events": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|MultiEdit|NotebookEdit",
          "hooks": [
            { "type": "command", "command": "node .agents/hooks/guard-develop.mjs" }
          ]
        },
        {
          "matcher": "Bash|PowerShell",
          "hooks": [
            { "type": "command", "command": "node .agents/hooks/policy-zcode.mjs" }
          ]
        }
      ]
    }
  }
}
